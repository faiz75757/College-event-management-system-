# MongoDB Atlas connection string (put your database name before the ?)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/b4events?retryWrites=true&w=majority
# Any long random text, used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string
# Secret code needed to register as an admin
ADMIN_SECRET_CODE=choose-a-secret-admin-code
PORT=5000
